<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <RootNamespace>Kleptos</RootNamespace>
    <AssemblyName>Kleptos</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
    <AvaloniaResource Include="fonts/**" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.2" />
    <PackageReference Include="Velopack" Version="0.0.1053" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows ships with yt-dlp.exe / ffmpeg.exe next to the app. On macOS/Linux,
         yt-dlp is downloaded per-platform at runtime; ffmpeg is expected on PATH.
         Only copy the .exe binaries for Windows (or local no-RID dev builds). -->
    <None Update="ffmpeg.exe" Condition="Exists('ffmpeg.exe') and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="yt-dlp.exe" Condition="Exists('yt-dlp.exe') and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
